<!DOCTYPE html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FraudLink · Circular exchange evidence</title><style>
*{box-sizing:border-box}body{margin:0;background:#090f19;color:#eff6ff;font:16px/1.45 "Segoe UI",sans-serif}header{padding:15px max(5vw,20px);border-bottom:1px solid #283448;background:#0d1724;display:flex;align-items:center;gap:12px}header b{font-size:24px;letter-spacing:-1.5px}header b span{color:#70dfcf}header small{margin-left:auto;color:#a8b8cc}main{max-width:1160px;margin:auto;padding:37px 24px}h1{font-size:clamp(35px,5vw,58px);letter-spacing:-.06em;margin:5px 0}h2{font-size:19px;margin:0}p,small,label{color:#aebed0}p{margin:5px 0 22px}.kicker{font:700 11px monospace;color:#6cdeca;letter-spacing:2px}.cards,.grid{display:grid;gap:14px}.cards{grid-template-columns:repeat(4,1fr);margin:25px 0 16px}.card,section{border:1px solid #293a4e;background:linear-gradient(135deg,#152334,#101925);border-radius:12px}.card{padding:17px 20px}.card b{display:block;font-size:30px;letter-spacing:-1.5px;margin-top:6px}.grid{grid-template-columns:minmax(0,1.4fr) minmax(270px,1fr)}section{padding:20px}.head{display:flex;align-items:center;justify-content:space-between;gap:8px}select,button{background:#142739;color:#e5eef7;border:1px solid #395166;border-radius:6px;padding:7px 9px;font:inherit}button{cursor:pointer}svg.map{background-color:#0b1624;background-image:radial-gradient(#314055 1px,transparent 1px);background-size:14px 14px;border-radius:8px;margin:16px 0 6px;width:100%;height:265px}.node{cursor:pointer}.node:focus{outline:2px solid #72dbcf}.entry{border-top:1px solid #29394c;padding:12px 0}.entry b,.entry small{display:block}.value{color:#fa95aa}#summary{margin:12px 0;color:#a6bacb}.foot{font-size:14px;margin-top:22px}.hint{font-size:13px;color:#a5b5c8}.pill{border:1px solid #42625b;border-radius:12px;padding:3px 8px;color:#86e4cf;font-size:12px}#detail{min-height:22px;color:#78e2d0}.head select{max-width:45%}@media(max-width:760px){.grid{grid-template-columns:1fr}.cards{grid-template-columns:1fr 1fr}.card{padding:12px}header small{font-size:11px}main{padding:20px 13px}}
</style><header><svg width="33" height="37" viewBox="0 0 33 37"><path d="m16 2 14 7v16L16 35 2 25V9Z" fill="#14343b" stroke="#5de1ce" stroke-width="2"/><path d="m8 23 7-12 10 6-9 10-8-4 17-6" stroke="#89efdd" fill="none" stroke-width="2"/></svg><b>Fraud<span>Link</span></b><small>OFFLINE EVIDENCE WALKTHROUGH</small></header><main><div class="kicker">EXCHANGE INTELLIGENCE</div><h1>Circular exchange review</h1><p>Explore the time-ordered transfer rings detected in the synthetic transaction dataset.</p><div class="cards" id="stats"></div><div class="grid"><section><div class="head"><h2>Exchange network</h2><select id="group" aria-label="Select ring group"></select></div><svg class="map" id="map" viewBox="0 0 430 255" aria-label="Directed account relationship graph"></svg><small>Choose an account to inspect its transfers.</small><p id="detail" aria-live="polite"></p></section><section><div class="head"><h2>Transfer evidence</h2><span class="pill">Chronological</span></div><p id="summary"></p><div id="timeline"></div></section></div><p class="foot">This walkthrough runs on evidence captured by the backend’s chronological ring rule. The full console adds Isolation Forest scoring, DBSCAN behavioral groups, MongoDB-backed cases and PDF exports.</p></main><script>
const data=__DATA__;
const money=v=>v.toLocaleString('en-US',{style:'currency',currency:'USD'});
const get=id=>document.getElementById(id);
const cards=[['Transactions analyzed',data.total],['Ring groups',data.groups.length],['Evidence transfers',data.flagged_ids.length],['Accounts in rings',new Set(data.groups.flat()).size]];
get('stats').innerHTML=cards.map(([k,v])=>'<div class="card"><small>'+k+'</small><b>'+v.toLocaleString()+'</b></div>').join('');
data.groups.forEach((g,i)=>get('group').add(new Option('Ring '+String(i+1).padStart(2,'0'),i)));
function show(){
 const group=data.groups[Number(get('group').value)],rings=data.rings.filter(r=>r.accounts.every(a=>group.includes(a))),ring=rings[0];
 const evidence=[...new Set(rings.flatMap(r=>r.transactions))].map(id=>data.evidence[id]).sort((a,b)=>a.timestamp.localeCompare(b.timestamp));
 const coords=[[203,45],[335,174],[78,174]],ns='http://www.w3.org/2000/svg',svg=get('map');
 svg.innerHTML='<defs><marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6" fill="#fa839a"/></marker></defs>';
 function el(tag,attr,parent=svg){let n=document.createElementNS(ns,tag);Object.entries(attr).forEach(([k,v])=>n.setAttribute(k,v));parent.append(n);return n}
 ring.accounts.forEach((a,i)=>{let [x,y]=coords[i],[u,v]=coords[(i+1)%3],l=Math.hypot(u-x,v-y);el('line',{x1:x+(u-x)*22/l,y1:y+(v-y)*22/l,x2:u-(u-x)*30/l,y2:v-(v-y)*30/l,stroke:'#b95b76','stroke-width':2.4,'marker-end':'url(#arrow)'})});
 function select(a){let related=evidence.filter(r=>r.sender===a||r.receiver===a);get('detail').textContent=a+' · '+related.length+' evidence transfers · '+money(related.reduce((sum,r)=>sum+r.amount,0))+' transferred';}
 ring.accounts.forEach((a,i)=>{let [x,y]=coords[i],g=el('g',{class:'node',tabindex:0,role:'button','aria-label':'Inspect '+a});g.onclick=()=>select(a);g.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select(a)}};el('circle',{cx:x,cy:y,r:26,fill:'#522b40',opacity:.55},g);el('circle',{cx:x,cy:y,r:17,fill:'#ef7692',stroke:'#a34761','stroke-width':4},g);el('text',{x,y:y+44,'text-anchor':'middle',fill:'#e4eaf7','font-size':14,'font-family':'monospace'},g).textContent=a});
 get('summary').textContent=rings.length+' matched loop'+(rings.length===1?'':'s')+' · first loop completed in '+ring.elapsed_minutes+' minutes.';
 get('timeline').innerHTML=evidence.map(r=>'<div class="entry"><small>'+r.timestamp.slice(0,16).replace('T',' ')+' UTC · '+r.id+'</small><b>'+r.sender+' → '+r.receiver+'</b><span class="value">'+money(r.amount)+'</span></div>').join('');
 select(ring.accounts[0]);
}
get('group').onchange=show;show();
</script></html>

